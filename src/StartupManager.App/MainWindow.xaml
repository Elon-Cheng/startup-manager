<Window x:Class="StartupManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico" Title="开机自启管理" Width="1320" Height="860" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#12253C">
      <DockPanel Margin="20,28">
        <StackPanel DockPanel.Dock="Top">
          <Border Width="42" Height="42" CornerRadius="12" Background="#3AD5B2" HorizontalAlignment="Left"><TextBlock Text="启" Foreground="#12253C" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="开机自启管理" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,4"/>
          <TextBlock Text="让启动，由你决定" Foreground="#9AAEC5" FontSize="12"/>
          <Border Background="#243D56" CornerRadius="8" Padding="14,12" Margin="0,38,0,8"><TextBlock Text="▦   启动项总览" Foreground="White"/></Border>
          <Button Content="◷   操作历史" Command="{Binding HistoryCommand}" Style="{StaticResource QuietButton}" Foreground="#BACADD" HorizontalContentAlignment="Left" Margin="0,2"/>
          <Button Content="↗   Windows 启动设置" Command="{Binding SettingsCommand}" Style="{StaticResource QuietButton}" Foreground="#BACADD" FontSize="12" Margin="0,8"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Button Content="帮助与关于" Click="ShowHelp" Style="{StaticResource QuietButton}" Foreground="#BACADD" HorizontalContentAlignment="Left" Margin="0,0,0,12"/>
          <Border Height="1" Background="#314459" Margin="0,0,0,18"/>
          <TextBlock Text="本机管理 · 可恢复" Foreground="#76D9C4" FontSize="12"/>
          <TextBlock Text="修改前保存原始配置，&#10;每次操作后重新核验。" Foreground="#9AAEC5" FontSize="11" LineHeight="20" Margin="0,8,0,20"/>
          <TextBlock x:Name="VersionLabel" Foreground="#6D859F" FontSize="9"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,24">
        <Button DockPanel.Dock="Right" Content="↻  刷新启动项" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        <StackPanel><TextBlock Text="启动项总览" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="查看这台电脑的自动启动入口，按需关闭，随时恢复。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
      </DockPanel>
      <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,20">
        <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="扫描到的入口" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding TotalCount}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="任务已开启" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding EnabledCount}" FontSize="30" FontWeight="SemiBold" Foreground="#147D73" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="本工具已关闭" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding DisabledCount}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="状态待确认 / 检查" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding UnknownCount}" FontSize="30" FontWeight="SemiBold" Foreground="#AA751F" Margin="0,4,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Grid Grid.Row="2" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="128"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索软件名称、路径或启动参数" AutomationProperties.Name="搜索启动项"/>
          <TextBlock Text="搜索软件名称、路径或参数…" Foreground="#8A97A8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <ComboBox Grid.Column="1" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" Margin="0,0,10,0" AutomationProperties.Name="状态筛选"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Margin="0,0,12,0" AutomationProperties.Name="来源筛选"/>
        <CheckBox Grid.Column="3" Content="显示只读项" IsChecked="{Binding ShowProtected}" VerticalAlignment="Center" FontSize="12"/>
      </Grid>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="10" BorderBrush="#E1E7EF" BorderThickness="1" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="16,14"><TextBlock Text="自动启动入口" FontWeight="SemiBold"/><TextBlock Text="{Binding VisibleSummary}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" BorderThickness="0" Background="White" GridLinesVisibility="None" RowHeight="52" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True">
              <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F8FB"/><Setter Property="Foreground" Value="#63738B"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderThickness" Value="0"/></Style>
                <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
                <Style TargetType="DataGridRow"><Setter Property="BorderBrush" Value="#F0F3F7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F6F2"/><Setter Property="Foreground" Value="#182B46"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F7F6"/></Trigger></Style.Triggers></Style>
              </DataGrid.Resources>
              <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Background="White"><Expander.Header><TextBlock Text="{Binding Name}" FontSize="11" Foreground="#63738B" Margin="4,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="软件 / 入口" Width="*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel ToolTip="{Binding Entry.Name}"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,9,0"/><TextBlock Text="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="状态" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Entry.StateLabel}" Foreground="{Binding StateBrush}" FontSize="11"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="来源" Binding="{Binding Entry.SourceLabel}" Width="92"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="没有匹配的启动项。&#10;可尝试调整筛选条件或刷新。" Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding EmptyVisibility}"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E1E7EF" BorderThickness="1" Padding="18">
          <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="入口详情" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
              <TextBlock Text="{Binding SelectedTitle}" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Selected.Entry.StateLabel}" Foreground="{Binding Selected.StateBrush}" Margin="0,9,0,0"/>
              <TextBlock Text="程序位置" Style="{StaticResource Caption}"/><TextBox Text="{Binding Selected.Entry.Executable, Mode=OneWay}" Style="{StaticResource Selectable}"/>
              <TextBlock Text="启动参数" Style="{StaticResource Caption}"/><TextBox Text="{Binding Selected.Entry.Arguments, Mode=OneWay}" Style="{StaticResource Selectable}"/>
              <TextBlock Text="原始命令" Style="{StaticResource Caption}"/><TextBox Text="{Binding Selected.Entry.Command, Mode=OneWay}" Style="{StaticResource Selectable}"/>
              <TextBlock Text="触发时机 / 作用范围" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Selected.ScopeAndTrigger}"/>
              <TextBlock Text="启动入口" Style="{StaticResource Caption}"/><TextBox Text="{Binding Selected.LocationLabel, Mode=OneWay}" Style="{StaticResource Selectable}"/>
              <Border Background="#F4F7FA" CornerRadius="6" Padding="11" Margin="0,18,0,14"><TextBlock Text="{Binding DetailNote}" Foreground="#63738B" FontSize="11" LineHeight="18"/></Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1">
            <Border Height="1" Background="#E6ECF3" Margin="0,0,0,12"/>
            <Button Content="关闭这个自启入口" Command="{Binding DisableCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
            <Button Content="恢复原配置 / 开启任务" Command="{Binding RestoreCommand}" Margin="0,0,0,8"/>
            <Button Content="关闭此软件的全部可控入口" Command="{Binding DisableGroupCommand}" FontSize="11" Padding="8,7" Margin="0,0,0,6"/>
            <Button Content="保留当前配置并归档旧备份" Command="{Binding ArchiveCommand}" FontSize="11" Padding="8,7" Margin="0,0,0,3"/>
            <Button Content="打开程序所在位置 ↗" Command="{Binding OpenLocationCommand}" Style="{StaticResource QuietButton}" FontSize="11"/>
          </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,12,0,0">
        <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" Foreground="{StaticResource Accent}" BorderThickness="0" Margin="0,0,0,7"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="查看扫描提示" Command="{Binding ErrorsCommand}" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
